# WeChat Download API 配置文件
# 复制为 .env 后使用: cp env.example .env

# 微信读书 Web 认证（推荐在 /login.html 校验并保存到 data/，这里仅作无状态部署回退）
WEREAD_COOKIE=
# 可选备用；本机登录页会先尝试通过 /web/login/renewal 自动获取
WEREAD_TICKET=
# 可选备用；部分会话使用 x-wrpa-0 代替 x-wr-ticket
WEREAD_WRPA=
# 可选，默认从 Cookie 的 wr_vid 提取
WEREAD_VID=

# 限频配置 (单位: 次/分钟 或 秒)
RATE_LIMIT_GLOBAL=10
RATE_LIMIT_PER_IP=5
RATE_LIMIT_ARTICLE_INTERVAL=3

# Webhook 通知 (留空则禁用，支持企业微信群机器人)
WEBHOOK_URL=
# 同一事件通知最小间隔（秒），防止重复轰炸
WEBHOOK_NOTIFICATION_INTERVAL=300

# RSS 订阅配置
# 轮询间隔（秒），默认 7200（2 小时）
RSS_POLL_INTERVAL=7200
# 每个公众号每轮最多处理的文章数
ARTICLES_PER_POLL=10
# RSS 轮询时是否获取完整文章内容（true/false），默认 true
RSS_FETCH_FULL_CONTENT=true
# 同时抓取正文的最大并发数；微信读书链路建议保持 1-2
RSS_CONTENT_CONCURRENCY=2

# 旧直链文章解析功能仍可使用此代理池；微信读书文章列表/正文客户端不读取此项。
# 支持 SOCKS5，多个用逗号分隔。
PROXY_URLS=

# 服务配置
# 网站URL(用于RSS图片代理,必须配置为实际访问地址)
# 例如: http://你的IP:5000 或 https://你的域名.com
SITE_URL=http://localhost:5000
PORT=5000
HOST=0.0.0.0
DEBUG=false

# 数据库路径（默认 ./data/rss.db，Docker 环境一般无需修改）
# RSS_DB_PATH=/app/data/rss.db

# ===== MCP（AI 客户端接入，可选）=====
# 开启后 Claude/Codex/Cline 等 AI 客户端可直接搜索/订阅/读你的公众号文章。
# ENABLE_MCP=1 且设置 MCP_TOKEN 才启用；客户端需配 Authorization: Bearer <MCP_TOKEN>。
ENABLE_MCP=0
MCP_TOKEN=
# MCP 资源 URL（部署域名，用于 DNS-rebinding 白名单；默认 localhost）
# MCP_RESOURCE_URL=https://你的域名/mcp
